// hud.slang — the cockpit display, drawn entirely as distance fields.
//
//   fragHud   one full-screen pass, alpha blended over the resolved picture
//
// There is no font texture, no glyph atlas and no UI widget library in the
// render path. A real HUD is a vector display, so this one is too: every mark -
// the pitch ladder, the tape boxes, the annunciators and the letters themselves
// - is a line segment evaluated through one signed-distance function. That
// costs a few dozen segments for the pixels that are actually near a mark, and
// nothing at all for the rest, because each instrument rejects on its own
// bounding region first.
//
// The stroke font is demos/flightsim/hud_font.h, generated by
// tools/gen_hud_font.py, uploaded once into the device arena and read through
// muScene. Text the simulator wants to say is a display list the CPU writes
// each frame; text the instruments need (a ladder's pitch value, a tape's
// number) is drawn from the value itself, so it can never disagree with the
// needle beside it.
#include "fs_common.slang"

import mu_gfx;

// Glyph index of '0' in hud_font.h. The generator's ORDER is blank, digits,
// punctuation, letters, so a digit d is glyph 1 + d. Changing the generator's
// order means changing this.
#define FS_GLYPH_ZERO 1u

struct HudPush
{
    float4 size;        // x width, y height, z 1 / width, w 1 / height
    float4 speed;       // x indicated airspeed kt, y true airspeed kt, z mach, w ground speed kt
    float4 alt;         // x pressure altitude ft, y radio altitude ft AGL, z vertical speed ft/min, w target alt
    float4 att;         // x pitch deg, y roll deg, z heading deg, w load factor g
    float4 aero;        // x angle of attack deg, y sideslip deg, z stall margin 0..1, w speedbrake
    float4 engine;      // x throttle 0..1, y rpm fraction, z fuel fraction, w engine health
    float4 warn;        // x warning bitmask, y seconds (for the blink), z flash rate, w unused
    float4 status;      // x flight model, y cloud mode, z frames per second, w cloud ms
    uint4  font;        // x glyph-table byte offset, y segment-table byte offset, z stride, w unused
    uint4  text;        // x display-list byte offset, y item count, z item stride, w unused
    // One cap height for the whole display list. Every label an annunciator
    // panel wants is the same size, and a per-item height would make the item
    // 48 bytes to carry a number that never varies. A caller that genuinely
    // needs two sizes writes two lists with two pushes, which it would not.
    float4 text_style;  // x cap height, y advance scale, z, w unused
    float4 colour;      // rgb the HUD's colour, a master intensity
};
[[vk::push_constant]] ConstantBuffer<HudPush> pc;

enum
{
    WARN_STALL    = 1u << 0,
    WARN_PULL_UP  = 1u << 1,
    WARN_OVERSPEED = 1u << 2,
    WARN_GROUND   = 1u << 3,
    WARN_FUEL     = 1u << 4,
    WARN_CRASHED  = 1u << 5,
};

// ---- stroke primitives ----------------------------------------------------

// Distance from p to the segment ab.
float fsSeg(float2 p, float2 a, float2 b)
{
    float2 pa = p - a;
    float2 ba = b - a;
    float  h  = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-9), 0.0, 1.0);
    return length(pa - ba * h);
}

// Coverage of a stroke of width w centred on that distance. `aa` is one pixel
// in HUD units, so every mark in the display is antialiased by construction
// rather than by a supersample the pass cannot afford.
float fsStroke(float d, float w, float aa)
{
    return 1.0 - smoothstep(w * 0.5, w * 0.5 + aa, d);
}

// The distance to a rectangle outline: the tape boxes and the annunciator
// frames. A distance, not a coverage, so the caller decides the stroke width.
float fsRect(float2 p, float2 half_ext)
{
    float2 d = abs(p) - half_ext;
    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}

// ---- the font -------------------------------------------------------------

// One glyph. p is relative to the glyph's top-left corner with +y down, in HUD
// units; h is the cap height. Returns coverage.
//
// The bounding test is the point of the whole design: a pixel that is not inside
// this character's box never loads a single segment, so the cost of a twelve
// character readout is the cost of twelve comparisons plus the strokes of the
// one or two characters the pixel is actually on.
float fsGlyph(float2 p, uint glyph, float h, float aa)
{
    float w = h * (5.0 / 7.0);
    if (any(p < float2(-aa, -aa)) || p.x > w + aa || p.y > h + aa) return 0.0;

    uint4 rec = muScene.Load<uint4>(pc.font.x + glyph * 16u);
    float cov = 0.0;
    for (uint s = 0u; s < rec.y; ++s) {
        uint   seg = muScene.Load<uint>(pc.font.y + (rec.x + s) * pc.font.z);
        float2 a   = float2(float(seg & 15u),        float((seg >> 4)  & 15u)) * float2(w / 4.0, h / 6.0);
        float2 b   = float2(float((seg >> 8) & 15u), float((seg >> 12) & 15u)) * float2(w / 4.0, h / 6.0);
        cov = max(cov, fsStroke(fsSeg(p, a, b), h * 0.15, aa));
    }
    return cov;
}

// An unsigned integer of exactly `digits` characters, right-aligned at p.
float fsNumber(float2 p, int value, uint digits, float h, float aa)
{
    float w   = h * (5.0 / 7.0);
    float adv = w * 1.35;
    float cov = 0.0;
    int   v   = abs(value);
    for (uint k = 0u; k < digits; ++k) {
        int   place = 1;
        for (uint j = 0u; j < k; ++j) place *= 10;
        int   dv    = (v / place) % 10;
        // Right aligned: the units digit's left edge is at -adv, the tens at
        // -2 * adv, and so on.
        float2 q   = p - float2(-adv * float(k + 1u), 0.0);
        cov = max(cov, fsGlyph(q, FS_GLYPH_ZERO + uint(dv), h, aa));
    }
    return cov;
}

// A signed integer, drawing the minus from the font's punctuation.
float fsSigned(float2 p, int value, uint digits, float h, float aa)
{
    float w   = h * (5.0 / 7.0);
    float adv = w * 1.35;
    float cov = value < 0 ? fsGlyph(p - float2(-adv * float(digits + 1u), 0.0), 11u, h, aa) : 0.0;
    return max(cov, fsNumber(p, value, digits, h, aa));
}

// ---- display list ---------------------------------------------------------

// One text item, 32 bytes, written by the CPU each frame:
//   x, y      position of the first character's top-left, in HUD units
//   a         alpha, already carrying any blink the CPU wanted
//   n         character count, so the bounding-box reject below knows the
//             line's width without reading a single glyph
//   glyphs    up to 16 glyph indices, one byte each, little-endian within a word
//
// There is no per-item colour. The display list contributes one coverage and
// the whole HUD takes one tint, which is what lets the warning bitmask recolour
// every label in a single select. A colour field here would be a field nothing
// reads, and the CPU would spend a frame writing it.
struct HudTextItem
{
    float4 box;        // x, y, a, n
    uint4  glyphs;     // characters 0..15
};

float fsDisplayList(float2 hp, float aa)
{
    uint  count = pc.text.y;
    float h     = pc.text_style.x;
    float w     = h * (5.0 / 7.0);
    float adv   = w * pc.text_style.y;
    float cov   = 0.0;
    for (uint i = 0u; i < count; ++i) {
        HudTextItem it = muScene.Load<HudTextItem>(pc.text.x + i * pc.text.z);
        uint  n   = uint(it.box.w + 0.5);
        // Reject the whole line first: text items are horizontal bands, so one
        // y comparison kills most of them for most pixels, and the x extent is
        // known from n without touching the glyph bytes.
        float2 rel = hp - it.box.xy;
        if (rel.y < -aa || rel.y > h + aa || rel.x < -aa || rel.x > adv * float(n) + aa) continue;
        for (uint k = 0u; k < n && k < 16u; ++k) {
            uint g = (it.glyphs[k >> 2u] >> ((k & 3u) * 8u)) & 0xFFu;
            cov  = max(cov, fsGlyph(rel - float2(adv * float(k), 0.0), g, h, aa) * it.box.z);
        }
    }
    return cov;
}

// ---- entry ----------------------------------------------------------------

float4 fragHud(FullscreenVaryings i) : SV_Target0
{
    float2 size = pc.size.xy;
    float  aa   = 2.0 / size.y;                      // one pixel in HUD units
    float  aspect = size.x / size.y;

    // HUD space: y up, x scaled by the aspect ratio, so a circle is a circle
    // and a stroke width means the same thing horizontally and vertically.
    float2 hp = float2((2.0 * i.uv.x - 1.0) * aspect, 1.0 - 2.0 * i.uv.y);

    float  pitch = pc.att.x;
    float  roll  = pc.att.y;
    float  head  = pc.att.z;
    float  cov   = 0.0;

    // The bitmask's job here is the display's colour: a HUD whose letters are
    // already in the CPU's list still has to be able to go red as a whole, and
    // that is one select rather than one more text item.
    uint   warn  = uint(pc.warn.x + 0.5);
    float3 tint  = (warn & (WARN_STALL | WARN_PULL_UP | WARN_GROUND | WARN_CRASHED)) != 0u
                   ? float3(1.00, 0.30, 0.20)
                   : pc.colour.rgb;

    // Roll rotates the whole ladder about the HUD's centre, which is what makes
    // a bank read as a bank instead of as a translating line.
    float  cr = cos(radians(roll)), sr = sin(radians(roll));
    float2 rp = float2(hp.x * cr - hp.y * sr, hp.x * sr + hp.y * cr);

    // ---- pitch ladder ----
    // Only the part of the screen the ladder can reach is evaluated. Each rung
    // is 10 degrees apart with a 5 degree half rung between, and the rungs below
    // the horizon are broken, which is the convention that stops an inverted
    // ladder from reading as a level one.
    {
        float ppd = 0.0135;                          // HUD units per degree
        float2 q  = rp;
        if (abs(q.y) < 0.95 && abs(q.x) < 0.42) {
            for (int k = -8; k <= 8; ++k) {
                float ang = float(k) * 5.0;
                float y   = (pitch - ang) * ppd;
                float d   = abs(q.y - y);
                if (d > 0.05) continue;
                bool  major = (k & 1) == 0;
                float half_w = major ? 0.16 : 0.075;
                float stroke = fsStroke(abs(q.y - y), aa * 1.6, aa) *
                               (abs(q.x) < half_w ? 1.0 : 0.0);
                // Below the horizon the rung is broken into two, with a gap at
                // the centre, and its ends tick downward.
                if (k < 0) {
                    stroke *= (abs(q.x) > half_w * 0.28) ? 1.0 : 0.0;
                    float tick = fsSeg(q, float2(half_w, y), float2(half_w, y + 0.035));
                    tick = min(tick, fsSeg(q, float2(-half_w, y), float2(-half_w, y + 0.035)));
                    stroke = max(stroke, fsStroke(tick, aa * 1.6, aa));
                }
                cov = max(cov, stroke);
                if (major && k != 0) {
                    int  v = abs(int(ang));
                    uint dg = v >= 10 ? 2u : 1u;
                    cov = max(cov, fsNumber(float2(q.x - (half_w + 0.030 + 0.052 * float(dg)), q.y - y - 0.028),
                                            v, dg, 0.056, aa));
                    cov = max(cov, fsNumber(float2(q.x + (half_w + 0.082), q.y - y - 0.028),
                                            v, dg, 0.056, aa));
                }
            }
        }
    }

    // ---- roll arc and pointer ----
    {
        float r = length(rp);
        if (abs(r - 0.46) < 0.05) {
            float ang = atan2(rp.x, rp.y);           // 0 straight up, + to the right
            cov = max(cov, fsStroke(abs(r - 0.46), aa * 1.4, aa) * (abs(ang) < radians(70.0) ? 1.0 : 0.0));
            // Ticks at 0, 10, 20, 30, 45, 60 either side.
            static const float k_ang[7] = { 0.0, 10.0, 20.0, 30.0, 45.0, 60.0, 70.0 };
            for (int k = -6; k <= 6; ++k) {
                float a0 = radians(k_ang[abs(k)]) * (k < 0 ? -1.0 : 1.0);
                float2 dir = float2(sin(a0), cos(a0));
                float  len = (k == 0 || abs(k) == 3) ? 0.045 : 0.028;
                cov = max(cov, fsStroke(fsSeg(rp, dir * 0.46, dir * (0.46 + len)), aa * 1.5, aa));
            }
        }
        // The pointer rides the horizon line and moves with the aircraft, so it
        // is drawn in unrotated space against the rotated arc.
        float2 pp = float2(hp.x * cr + hp.y * sr, -hp.x * sr + hp.y * cr);
        if (abs(pp.y + 0.42) < 0.05 && abs(pp.x) < 0.04) {
            cov = max(cov, fsStroke(abs(pp.y + 0.42), aa * 1.6, aa) * (abs(pp.x) < 0.03 ? 1.0 : 0.0));
        }
    }

    // ---- waterline: the fixed aircraft reference symbol ----
    // A short horizontal bar with both ends turned down, bolted to the centre of
    // the display. It is the aircraft; everything else moves around it.
    if (abs(hp.x) < 0.14 && abs(hp.y) < 0.06) {
        float d = min(fsSeg(hp, float2(-0.115, 0.0), float2(-0.040, 0.0)),
                      fsSeg(hp, float2( 0.040, 0.0), float2( 0.115, 0.0)));
        d = min(d, fsSeg(hp, float2(-0.040, 0.0), float2(-0.040, 0.030)));
        d = min(d, fsSeg(hp, float2( 0.040, 0.0), float2( 0.040, 0.030)));
        cov = max(cov, fsStroke(d, aa * 2.0, aa));
    }

    // ---- flight path marker: where the aircraft is actually going ----
    // Angle of attack lifts it above the waterline and sideslip slides it
    // sideways, which is the whole reason the symbol exists: in a slip or a
    // heavy nose-up attitude the two are visibly apart.
    {
        float2 fpm = float2(clamp(pc.aero.y * 0.030, -0.30, 0.30),
                            clamp(-pc.aero.x * 0.0135, -0.35, 0.35));
        if (length(hp - fpm) < 0.10) {
            float2 q = hp - fpm;
            float  d = abs(length(q) - 0.026);
            d = min(d, fsSeg(q, float2(-0.066, 0.0), float2(-0.026, 0.0)));
            d = min(d, fsSeg(q, float2( 0.026, 0.0), float2( 0.066, 0.0)));
            d = min(d, fsSeg(q, float2(0.0, 0.026), float2(0.0, 0.050)));
            cov = max(cov, fsStroke(d, aa * 2.0, aa));
        }
    }

    // ---- speed tape, left ----
    {
        float  tx   = -0.60 * aspect;
        float  kts  = pc.speed.x;
        float  per  = 20.0 / 0.075;                  // knots per HUD unit
        if (abs(hp.x - tx) < 0.20 && abs(hp.y) < 0.30) {
            for (int k = -3; k <= 3; ++k) {
                float v = floor(kts / 20.0) * 20.0 + float(k) * 20.0;
                float y = (kts - v) / per;
                if (abs(y) > 0.26) continue;
                float major = fmod(abs(v), 100.0) < 0.5 ? 1.0 : 0.0;
                float w = 0.020 + 0.022 * major;
                cov = max(cov, fsStroke(fsSeg(hp, float2(tx, y), float2(tx + w, y)), aa * 1.6, aa));
                if (major > 0.5)
                    cov = max(cov, fsNumber(float2(hp.x - (tx - 0.012), hp.y - y - 0.028),
                                            int(v), 3u, 0.056, aa));
            }
            // The box and the number that moves with the tape's own value.
            float2 bp = hp - float2(tx + 0.115, 0.0);
            cov = max(cov, fsStroke(fsRect(bp, float2(0.072, 0.040)), aa * 1.8, aa) * 0.9);
            cov = max(cov, fsNumber(float2(hp.x - (tx + 0.115 + 0.052), hp.y + 0.028),
                                    int(kts + 0.5), 3u, 0.056, aa));
        }
    }

    // ---- altitude tape, right ----
    {
        float  tx  = 0.60 * aspect;
        float  ft  = pc.alt.x;
        float  per = 200.0 / 0.075;
        if (abs(hp.x - tx) < 0.22 && abs(hp.y) < 0.30) {
            for (int k = -3; k <= 3; ++k) {
                float v = floor(ft / 200.0) * 200.0 + float(k) * 200.0;
                float y = (ft - v) / per;
                if (abs(y) > 0.26) continue;
                float w = 0.020 + 0.022 * (fmod(abs(v), 1000.0) < 0.5 ? 1.0 : 0.0);
                cov = max(cov, fsStroke(fsSeg(hp, float2(tx, y), float2(tx - w, y)), aa * 1.6, aa));
                if (fmod(abs(v), 1000.0) < 0.5)
                    cov = max(cov, fsNumber(float2(hp.x - (tx + 0.074), hp.y - y - 0.028),
                                            int(v), 4u, 0.050, aa));
            }
            float2 bp = hp - float2(tx - 0.130, 0.0);
            cov = max(cov, fsStroke(fsRect(bp, float2(0.082, 0.040)), aa * 1.8, aa) * 0.9);
            cov = max(cov, fsNumber(float2(hp.x - (tx - 0.130 + 0.062), hp.y + 0.028),
                                    int(ft + 0.5), 4u, 0.050, aa));
            // Radio altitude, boxed and only shown when it matters: below 2500
            // feet the number you want is the one to the ground, not to the sea.
            if (pc.alt.y < 2500.0 && abs(hp.x - tx) < 0.12 && abs(hp.y + 0.20) < 0.06) {
                cov = max(cov, fsStroke(fsRect(hp - float2(tx - 0.075, -0.20), float2(0.062, 0.034)), aa * 1.6, aa) * 0.8);
                cov = max(cov, fsNumber(float2(hp.x - (tx - 0.075 + 0.045), hp.y + 0.20 + 0.024),
                                        int(pc.alt.y + 0.5), 4u, 0.046, aa));
            }
        }
        // Vertical speed bar, outboard of the altitude tape.
        float vx = tx + 0.135;
        if (abs(hp.x - vx) < 0.05 && abs(hp.y) < 0.26) {
            cov = max(cov, fsStroke(fsRect(hp - float2(vx, 0.0), float2(0.016, 0.22)), aa * 1.4, aa) * 0.55);
            float vs = clamp(pc.alt.z / 2000.0, -1.0, 1.0);
            float y0 = vs > 0.0 ? 0.0 : vs * 0.22;
            float y1 = vs > 0.0 ? vs * 0.22 : 0.0;
            float2 q = hp - float2(vx, 0.0);
            if (q.y >= min(y0, y1) && q.y <= max(y0, y1) && abs(q.x) < 0.014) cov = max(cov, 0.85);
        }
    }

    // ---- heading tape, bottom ----
    {
        float ty  = -0.56;
        float per = 10.0 / 0.055;
        if (abs(hp.y - ty) < 0.09 && abs(hp.x) < 0.36 * aspect) {
            for (int k = -6; k <= 6; ++k) {
                float v = floor(head / 10.0) * 10.0 + float(k) * 10.0;
                float x = (v - head) / per;
                if (abs(x) > 0.34) continue;
                float major = fmod(abs(v), 30.0) < 0.5 ? 1.0 : 0.0;
                cov = max(cov, fsStroke(fsSeg(hp, float2(x, ty), float2(x, ty + 0.016 + 0.018 * major)), aa * 1.6, aa));
                if (major > 0.5) {
                    int lbl = int(fmod(abs(v), 360.0)) / 10;
                    cov = max(cov, fsNumber(float2(hp.x - (x + 0.020), hp.y - (ty - 0.058)),
                                            lbl, lbl >= 10 ? 2u : 1u, 0.048, aa));
                }
            }
            cov = max(cov, fsStroke(fsSeg(hp, float2(-0.34, ty), float2(0.34, ty)), aa * 1.4, aa) * 0.5);
            // The heading bug: a triangle above the tape at the centre.
            cov = max(cov, fsStroke(abs(hp.y - (ty + 0.075)), aa * 1.6, aa) * (abs(hp.x) < 0.020 ? 1.0 : 0.0));
            cov = max(cov, fsNumber(float2(hp.x + 0.020, hp.y - (ty - 0.135)), int(fmod(head + 360.0, 360.0) + 0.5), 3u, 0.052, aa));
        }
    }

    // ---- throttle and angle-of-attack, far left ----
    {
        float tx = -0.86 * aspect;
        if (abs(hp.x - tx) < 0.05 && abs(hp.y + 0.30) < 0.30) {
            cov = max(cov, fsStroke(fsRect(hp - float2(tx, -0.30), float2(0.014, 0.22)), aa * 1.4, aa) * 0.5);
            float th = clamp(pc.engine.x, 0.0, 1.0);
            float2 q = hp - float2(tx, -0.30);
            if (q.y >= -0.22 && q.y <= -0.22 + th * 0.44 && abs(q.x) < 0.012) cov = max(cov, 0.8);
        }
        // Angle of attack bracket against the stall margin: the closer the
        // bracket is to the bar, the closer the wing is to stopping flying.
        float ax = -0.74 * aspect;
        if (abs(hp.x - ax) < 0.05 && abs(hp.y) < 0.20) {
            cov = max(cov, fsStroke(fsSeg(hp, float2(ax, -0.18), float2(ax, 0.18)), aa * 1.2, aa) * 0.4);
            float a = clamp(1.0 - pc.aero.z, -1.0, 1.0) * 0.18;
            cov = max(cov, fsStroke(fsSeg(hp, float2(ax - 0.018, a), float2(ax + 0.018, a)), aa * 2.2, aa));
            float stall_y = 0.18;
            cov = max(cov, fsStroke(fsSeg(hp, float2(ax - 0.022, stall_y), float2(ax + 0.022, stall_y)), aa * 2.2, aa) * 0.7);
        }
    }

    // Annunciators are not a special case here. A warning is text at a position
    // with an alpha that blinks, which is exactly what a display-list item is,
    // so the flight code writes "STALL" into the list when the wing is about to
    // stop flying and this pass draws it like any other word. One place decides
    // what the HUD says; this one only decides how it looks.

    // ---- the CPU's text ----
    cov = max(cov, fsDisplayList(hp, aa));

    float a = saturate(cov) * pc.colour.a;
    if (a <= 0.002) return float4(0.0, 0.0, 0.0, 0.0);
    return float4(tint * a, a);                        // premultiplied for BLEND_PREMUL
}
